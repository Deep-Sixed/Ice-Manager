<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>IcePulseTest</AssemblyName>
    <RootNamespace>IcePulseTest</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Version>0.1.0.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>0.1.0.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyTitle>Ice Pulse Test</AssemblyTitle>
    <Product>Ice Pulse Test</Product>
    <Description>Space Engineers client-side 1 kg ice pulse proof of concept</Description>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Optimize>true</Optimize>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Stubs/VRage/VRage.csproj" Private="false" />
    <ProjectReference Include="../Stubs/VRage.Library/VRage.Library.csproj" Private="false" />
    <ProjectReference Include="../Stubs/VRage.Game/VRage.Game.csproj" Private="false" />
    <ProjectReference Include="../Stubs/Sandbox.Common/Sandbox.Common.csproj" Private="false" />
  </ItemGroup>
</Project>
