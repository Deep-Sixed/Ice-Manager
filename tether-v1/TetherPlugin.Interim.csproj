<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Tether-Pulsar-Interim</AssemblyName>
    <RootNamespace>CleanRoomTether</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="TetherPlugin.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Sandbox.Common" HintPath="$(SERefRoot)\Sandbox.Common.dll" Private="false" />
    <Reference Include="Sandbox.Game" HintPath="$(SERefRoot)\Sandbox.Game.dll" Private="false" />
    <Reference Include="SpaceEngineers.Game" HintPath="$(SERefRoot)\SpaceEngineers.Game.dll" Private="false" />
    <Reference Include="VRage" HintPath="$(SERefRoot)\VRage.dll" Private="false" />
    <Reference Include="VRage.Game" HintPath="$(SERefRoot)\VRage.Game.dll" Private="false" />
    <Reference Include="VRage.Library" HintPath="$(SERefRoot)\VRage.Library.dll" Private="false" />
    <Reference Include="VRage.Math" HintPath="$(SERefRoot)\VRage.Math.dll" Private="false" />
    <Reference Include="VRage.Input" HintPath="$(SERefRoot)\VRage.Input.dll" Private="false" />
  </ItemGroup>
</Project>
